APP_NAME="CLBK TOKE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ncimproject.tech
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

DB_CONNECTION=mysql
# Hostname internal resource MySQL Coolify, bukan 127.0.0.1.
DB_HOST=
DB_PORT=3306
DB_DATABASE=clbk
DB_USERNAME=clbk
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_bin

# IP proxy pada jaringan yang terhubung ke aplikasi; lihat DEPLOY.md.
TRUSTED_PROXIES=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Email dinonaktifkan; SMTP tidak diperlukan.
MAIL_ENABLED=false
MAIL_MAILER=array

LARAVEL_STORAGE_PATH=/data/storage
CLBK_PRIVATE_STORAGE=/data/proofs
BACKUP_PATH=/backups
# Folder terpisah pada disk VPS yang sama, sesuai pengaturan deployment ini.
BACKUP_REQUIRE_SEPARATE_DISK=false
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_TIME=23:00
BACKUP_MIN_FREE_BYTES=1073741824
LOG_CHANNEL=stderr
LOG_LEVEL=warning

WHATSAPP_ENABLED=false
FONNTE_TOKEN=
FONNTE_WEBHOOK_SECRET=
FONNTE_DEVICE=

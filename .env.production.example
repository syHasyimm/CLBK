APP_NAME="CLBK TOKE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Ganti dengan origin HTTPS server sebenarnya sebelum deployment.
APP_URL=https://clbk.example.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clbk
DB_USERNAME=clbk
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_bin
# Direktori privat stabil lintas release; sesuaikan dengan server sebenarnya.
CLBK_PRIVATE_STORAGE=/srv/clbk/shared/proofs
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Kosong untuk TLS langsung. Isi IP/CIDR proxy yang benar-benar dikelola.
TRUSTED_PROXIES=
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Isi konfigurasi SMTP nyata; jangan gunakan log/array atau fallback ke log.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

PROOFS_MAX_PER_DOCUMENT=5
PROOFS_MAX_BYTES_PER_USER=262144000
PROOFS_MAX_BYTES_TOTAL=2147483648
VITE_APP_NAME="${APP_NAME}"

# Wajib volume cadangan berbeda dari DB. Contoh: /mnt/clbk-backups atau E:/CLBK-Backups.
BACKUP_PATH=
BACKUP_REQUIRE_SEPARATE_DISK=true
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_TIME=23:00
BACKUP_MIN_FREE_BYTES=1073741824

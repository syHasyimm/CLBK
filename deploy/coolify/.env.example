# Template runtime Coolify. Salin ke .env.production untuk persiapan lokal.
# Nilai kosong WAJIB dilengkapi sebelum Deploy; jangan commit file berisi secret.
# Di Coolify: Runtime Variable aktif, Build Variable nonaktif.
APP_NAME="CLBK TOKE"
APP_ENV=production
# Database lama: gunakan APP_KEY sumber. Database baru: buat key sekali (DEPLOY.md 7.4).
APP_KEY=
APP_DEBUG=false
# Origin HTTPS aplikasi, tanpa path atau port internal :8080.
APP_URL=
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Resource MySQL 8.4 terpisah, pada destination/network Coolify yang sama.
# DB_HOST adalah hostname Internal URL MySQL, bukan localhost/domain aplikasi.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=clbk
DB_USERNAME=clbk
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_bin
# Path file privat di DALAM container aplikasi.
CLBK_PRIVATE_STORAGE=/data/proofs
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Jangan tambahkan SESSION_DOMAIN: cookie hanya berlaku pada host aplikasi.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Wajib isi IP/CIDR proxy Coolify yang nyata. Jangan gunakan wildcard.
# Cara memeriksa subnet: DEPLOY.md bagian 7.5.
TRUSTED_PROXIES=

# SMTP nyata, bukan log/array. Isi kredensial langsung di Coolify.
# Default ini STARTTLS port 587; sesuaikan dengan penyedia SMTP Anda.
# Brevo pada VPS yang memblokir 587: smtp/2525. TLS implisit: smtps/465.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="CLBK TOKE"

# Mount /backups wajib memakai disk berbeda dari /data dan volume data MySQL.
BACKUP_PATH=/backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# Jadwal aplikasi memakai Asia/Jakarta (WIB).
BACKUP_TIME=23:00
BACKUP_MIN_FREE_BYTES=1073741824

PROOFS_MAX_PER_DOCUMENT=5
PROOFS_MAX_BYTES_PER_USER=262144000
PROOFS_MAX_BYTES_TOTAL=2147483648

# Opsional, setelah membuat check monitoring (DEPLOY.md bagian 10).
# CLBK_MONITOR_PING_URL=

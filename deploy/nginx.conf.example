# Replace the domain, certificate paths, and release directory before enabling.
server {
    listen 80;
    server_name clbk.example.com;
    return 308 https://clbk.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name clbk.example.com;
    ssl_certificate /etc/letsencrypt/live/clbk.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/clbk.example.com/privkey.pem;
    root /srv/clbk/current/public;
    index index.php;
    charset utf-8;
    server_tokens off;
    client_max_body_size 11m;
    # Laravel applies these to dynamic responses; cover static and Nginx error responses too.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param HTTPS on;
        fastcgi_hide_header X-Powered-By;
        fastcgi_hide_header X-Content-Type-Options;
        fastcgi_hide_header X-Frame-Options;
        fastcgi_hide_header Referrer-Policy;
        fastcgi_hide_header Strict-Transport-Security;
        fastcgi_pass unix:/run/php/clbk.sock;
        fastcgi_read_timeout 300s;
    }
    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }
    location ~* \.(?:sqlite|sqlite3|db|zip|log|env)$ { deny all; }
}

<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/mysql-bootstrap.php" colors="true">
    <testsuites>
        <testsuite name="MySQL">
            <directory>tests/Unit</directory>
            <directory>tests/Feature/Auth</directory>
            <file>tests/Feature/MySqlDatabaseTest.php</file>
            <file>tests/Feature/MySqlBackupTest.php</file>
            <file>tests/Feature/FullWorkingDayTest.php</file>
            <file>tests/Feature/ReportsTest.php</file>
            <file>tests/Feature/DirectWeighingsTest.php</file>
            <file>tests/Feature/DirectVehicleWorkflowTest.php</file>
            <file>tests/Feature/DirectSalesAndSummaryTest.php</file>
            <file>tests/Feature/SingleCashTest.php</file>
            <file>tests/Feature/CreateBusinessCashTest.php</file>
            <file>tests/Feature/PayrollHistoryTest.php</file>
            <file>tests/Feature/UserManagementTest.php</file>
            <file>tests/Feature/WeighingDateFilterTest.php</file>
            <file>tests/Feature/SeedDateFilterCommandTest.php</file>
            <file>tests/Feature/DriverCustomerTest.php</file>
            <file>tests/Feature/BusinessSettingsTest.php</file>
            <file>tests/Feature/BootstrapUserTest.php</file>
            <file>tests/Feature/PricePageTest.php</file>
            <file>tests/Feature/ProfileTest.php</file>
            <file>tests/Feature/SecurityHardeningTest.php</file>
        </testsuite>
    </testsuites>
    <source><include><directory>app</directory></include></source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="cache"/>
        <env name="APP_MAINTENANCE_STORE" value="array"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="clbk_mysql_test" force="true"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_USERNAME" value="clbk_test"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>

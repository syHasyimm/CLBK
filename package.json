{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc && tsc -p tsconfig.pwa.json && vite build",
        "dev": "vite",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.pwa.json",
        "format": "prettier --write resources/js resources/css vite.config.ts",
        "format:check": "prettier --check resources/js resources/css vite.config.ts"
    },
    "devDependencies": {
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^2.0.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^24.0.0",
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.10",
        "@vitejs/plugin-react": "^4.2.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.9.9",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.0.2",
        "vite": "^7.0.7",
        "vite-plugin-pwa": "^2.0.0",
        "workbox-precaching": "^7.4.1",
        "workbox-routing": "^7.4.1",
        "workbox-strategies": "^7.4.1"
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.53.0",
        "radix-ui": "^1.7.0",
        "tailwind-merge": "^3.7.0"
    }
}
